# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Public URL of this app, used as the Deepgram transcription callback target.
# Local development: use an https tunnel since Deepgram must be able to reach this URL, e.g.:
#   brew install cloudflared && cloudflared tunnel --url http://localhost:3000
# then set APP_URL to the printed https://*.trycloudflare.com address (no account needed).
APP_URL=http://localhost:3000
