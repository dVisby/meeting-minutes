# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional dikte (dictation) providers — only required if you pick their
# model in the "Dikte modeli" dropdown. Leaving these unset is fine as long
# as nobody selects the corresponding model.

# Azure AI Speech (https://portal.azure.com — create a "Speech" resource)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Secret Vercel Cron sends as `Authorization: Bearer <value>` when polling
# Azure transcription jobs (see vercel.json). Set the same value in Vercel's
# project settings; leave both unset to disable the check in local dev.
CRON_SECRET=

# OpenAI (https://platform.openai.com — used for the Whisper model)
OPENAI_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey — used for Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# Public URL of this app, used as the Deepgram transcription callback target.
# Local development: use an https tunnel since Deepgram must be able to reach this URL, e.g.:
#   brew install cloudflared && cloudflared tunnel --url http://localhost:3000
# then set APP_URL to the printed https://*.trycloudflare.com address (no account needed).
APP_URL=http://localhost:3000

# Comma-separated list of emails allowed into /admin/api-keys. Everyone else
# with an account only sees their own meetings — no admin UI for them.
ADMIN_EMAILS=

# Random 32+ character passphrase used to encrypt provider API keys an admin
# saves from the /admin/api-keys panel (they're stored encrypted, never in
# plaintext). Generate one with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
